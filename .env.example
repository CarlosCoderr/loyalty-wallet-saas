DATABASE_URL=postgres://loyalty:loyalty@localhost:5433/loyalty
PORT=4000
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-o-mas-caracteres
JWT_EXPIRES_IN=12h
CORS_ORIGIN=*

# URL pública de la API (enlaces de descarga de tarjetas y webServiceURL del pase).
# En producción debe ser https. Por defecto: http://localhost:PORT
PUBLIC_BASE_URL=http://localhost:4000

# Wallet: 'mock' simula pases y avisos | 'production' firma pases reales de Apple
WALLET_PROVIDER=mock

# Apple Wallet (obligatorias con WALLET_PROVIDER=production; rutas relativas a la raíz del repo)
APPLE_PASS_TYPE_IDENTIFIER=pass.com.agencialuvo.loyalty
APPLE_TEAM_ID=XYZ123456
# Certificados PEM: WWDR de Apple (G4) + certificado y llave privada del Pass Type ID
APPLE_WWDR_CERT_PATH=./certs/apple/wwdr.pem
APPLE_SIGNER_CERT_PATH=./certs/apple/signerCert.pem
APPLE_SIGNER_KEY_PATH=./certs/apple/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=cambia-esto

# Google Wallet (aún no implementado)
GOOGLE_ISSUER_ID=3388000000000000000
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./certs/google/service-account.json
