// ==========================================
// MULTI-TENANT DIGITAL LOYALTY PLATFORM DB
// ==========================================
// Implementación: packages/api-server/src/db/schema.ts (Drizzle)
// Regla: toda tabla lleva tenant_id (ON DELETE CASCADE desde tenants).

Enum plan_tier {
  basic
  pro
  enterprise
}

Enum staff_role {
  admin
  cashier
}

Enum stamp_rule_type {
  per_amount
  per_visit
}

Enum pass_status {
  active
  suspended
}

Enum transaction_type {
  add_stamp
  redeem_reward
}

Enum reward_status {
  pending
  redeemed
}

Enum program_status {
  draft     // aún no emite pases
  active
  archived  // no suma sellos nuevos; los premios pendientes sí se canjean
}

Table tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  slug varchar(100) [unique, not null]
  owner_email varchar(255) [not null]
  phone varchar(50)
  plan_tier plan_tier [not null, default: 'basic']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table branches {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, not null]
  name varchar(255) [not null]
  code varchar(50)  // obligatorio en la API (ej. CENTRO); nullable por filas antiguas
  address text
  phone varchar(50)
  api_key_hash varchar(255) [unique] // solo el hash; la key en claro se muestra una vez
  created_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
    (tenant_id, code) [unique]
  }
}

Table staff_users {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, not null]
  branch_id uuid [ref: > branches.id] // ON DELETE SET NULL
  email varchar(255) [not null]
  password_hash varchar(255) [not null]
  full_name varchar(255)
  pin_hash varchar(255) // PIN rápido de 4 dígitos para cajero, hasheado
  role staff_role [not null, default: 'cashier']   // cashier requiere branch_id (validado en la API)
  is_active boolean [not null, default: true]
  token_version int [not null, default: 0]         // va en el JWT; +1 al cambiar contraseña/PIN
  failed_attempts int [not null, default: 0]       // intentos fallidos de login (incremento atómico)
  lockout_until timestamptz                        // bloqueo de 15 min al llegar a 5 fallos
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, email) [unique]
    branch_id
  }
}

Table loyalty_programs {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, not null]
  title varchar(255) [not null]
  description text

  // Reglas de Fidelización
  stamp_rule_type stamp_rule_type [not null, default: 'per_amount']
  amount_per_stamp decimal(10,2) [not null, default: 10.00]    // Ej: $10 = 1 Sello (> 0)
  min_purchase_amount decimal(10,2) [not null, default: 0.00]  // Umbral mínimo (>= 0)
  total_stamps int [not null, default: 10]                     // > 0
  reward_title varchar(255) [not null]
  reward_description text
  status program_status [not null, default: 'active']

  // Personalización Estética
  primary_color varchar(20) [not null, default: '#000000']
  background_color varchar(20) [not null, default: '#FFFFFF']
  label_color varchar(20) [not null, default: '#000000']
  logo_url text
  stamp_icon_url text
  banner_url text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
  }
}

Table customers {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, not null]
  phone varchar(50) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100)
  email varchar(255)
  birth_date date
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, phone) [unique]
  }
}

Table passes {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, not null]
  program_id uuid [ref: > loyalty_programs.id, not null] // ON DELETE RESTRICT
  customer_id uuid [ref: > customers.id, not null]
  serial_number varchar(100) [unique, not null] // QR escaneable
  authentication_token varchar(64) [not null]   // Apple PassKit Web Service
  current_stamps int [not null, default: 0]     // >= 0
  carryover_amount decimal(10,2) [not null, default: 0.00] // sobrante per_amount
  rewards_redeemed int [not null, default: 0]
  google_loyalty_object_id text
  status pass_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (program_id, customer_id) [unique]
    tenant_id
    customer_id
  }
}

// Apple Wallet: un pase puede estar en varios dispositivos, cada uno con su push token.
Table apple_devices {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, not null]
  device_library_identifier varchar(255) [not null]
  push_token text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, device_library_identifier) [unique]
  }
}

Table apple_registrations {
  tenant_id uuid [ref: > tenants.id, not null]
  device_id uuid [ref: > apple_devices.id, not null]
  pass_id uuid [ref: > passes.id, not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (device_id, pass_id) [pk]
    pass_id
  }
}

Table transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, not null]
  pass_id uuid [ref: > passes.id, not null] // ON DELETE RESTRICT (conserva historial)
  staff_id uuid [ref: > staff_users.id]     // ON DELETE SET NULL
  branch_id uuid [ref: > branches.id]       // ON DELETE SET NULL
  type transaction_type [not null]
  purchase_amount decimal(10,2) [not null, default: 0.00]
  stamps_added int [not null, default: 1]
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, created_at)
    pass_id
  }
}

// Cada tarjeta completada genera un premio 'pending'; el cajero lo canjea después.
Table reward_redemptions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, not null]
  pass_id uuid [ref: > passes.id, not null]                 // ON DELETE RESTRICT
  reward_title varchar(255) [not null]                      // copia del premio al ganarlo
  status reward_status [not null, default: 'pending']
  earned_transaction_id uuid [ref: > transactions.id]       // ON DELETE SET NULL
  redeemed_transaction_id uuid [ref: > transactions.id]     // ON DELETE SET NULL
  redeemed_by_staff_id uuid [ref: > staff_users.id]         // ON DELETE SET NULL
  redeemed_at_branch_id uuid [ref: > branches.id]           // ON DELETE SET NULL
  earned_at timestamptz [not null, default: `now()`]
  redeemed_at timestamptz                                   // obligatorio si status = redeemed

  indexes {
    (pass_id, status)
    tenant_id
  }
}
